NEXT_PUBLIC_SITE_URL=https://g.arcadia.uno
# Must match the browser origin, including port. Use http://localhost:3000 locally.
ARCADIA_AUTH_ORIGIN=https://g.arcadia.uno
ARCADIA_DATABASE_URL=libsql://your-database.turso.io
ARCADIA_DATABASE_AUTH_TOKEN=your-database-token
# Read-only signature checks for deployed EIP-1271 smart wallets; chain ID must be 42220.
ARCADIA_CELO_RPC_URL=https://forno.celo.org
# Optional: a tournament created using scripts/tournament.ts. Defaults to founding week.
ARCADIA_TOURNAMENT_ID=founding-week-2026-10-30
# Public Reown project ID. Allow https://g.arcadia.uno in its origin allowlist.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-reown-project-id
